{
    "compilerOptions": {
        "target": "ES2015",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": false,
        "allowJs": true,
        "declaration": true,
        "declarationDir": "./dist/types",
        "baseUrl": "./src",
        "paths": {
            "orion/*": ["orion/*"],
            "arquill/*": ["arquill/*"]
        },
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
